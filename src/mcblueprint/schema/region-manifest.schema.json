{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCBlueprint 分割出力 manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion",
    "format",
    "minecraftVersion",
    "seed",
    "inputSha256",
    "terrainSha256",
    "origin",
    "bounds",
    "regionSize",
    "regions"
  ],
  "properties": {
    "formatVersion": {
      "const": 1
    },
    "format": {
      "enum": [
        "schem",
        "litematic"
      ]
    },
    "minecraftVersion": {
      "type": "string"
    },
    "seed": {
      "type": "integer"
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "terrainSha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "max": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "regionSize": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "minItems": 3,
      "maxItems": 3
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "bounds",
          "offset",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^region-[0-9]{6,}\\.(schem|litematic)$"
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min",
              "max"
            ],
            "properties": {
              "min": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "max": {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 3,
                "maxItems": 3
              }
            }
          },
          "offset": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
